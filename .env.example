# WeChat mini-program credentials (leave empty for local dev / mock login).
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Runtime environment: development | production
APP_ENV=development

# Payment provider: mock | wechat
PAYMENT_PROVIDER=mock

# Allow mock payments to succeed. Kept off (0) in production as a kill-switch.
ALLOW_MOCK_PAYMENTS=1

# Cursor API key powering the AI coach (Grok). Leave empty to disable AI.
CURSOR_API_KEY=

# Backend API base URL injected into the Taro mini-program at build time.
TARO_APP_API_BASE=http://127.0.0.1:8000/api

# AI credits charged per interpretation/report request.
AI_CREDIT_COST=1
